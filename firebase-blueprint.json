      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "category": { "type": "string" },
        "contactPerson": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 256 },
        "state": { "type": "string", "maxLength": 64 },
        "paymentTerms": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "notes": { "type": "string", "maxLength": 512 }
      },
      "required": ["id", "organizationId", "name", "category", "contactPerson", "phone"]
    },
    "PurchaseRecord": {
      "title": "Purchase Record",
