        "createdAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "name", "state", "totalArea", "unit"]
    },
    "Field": {
      "title": "Field Block",
      "description": "Subdivided field plot with distinct irrigation infrastructure and boundaries",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "farmId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "size": { "type": "number" },
        "unit": { "type": "string", "enum": ["hectares", "acres"] },
