{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile associated with an organization and farm management role",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["owner", "manager", "agronomist", "member"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "organizationId", "role"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Multi-tenant tenant root isolating an agribusiness and its authorized users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "state": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerId", "state"]
    },
    "Farm": {
      "title": "Farm",
      "description": "Commercial farm estate parcel location and total acreage",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
