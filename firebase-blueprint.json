        "notes": { "type": "string", "maxLength": 512 }
      },
      "required": ["id", "organizationId", "farmId", "name", "seasonType", "startDate", "endDate", "status"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Agricultural input, equipment, labor, and logistics vendors",
