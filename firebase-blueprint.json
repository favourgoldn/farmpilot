      },
      "required": ["id", "organizationId", "farmId", "date", "category", "description", "amount", "paymentMethod", "paymentStatus"]
    },
    "HarvestRecord": {
      "title": "Harvest Record",
      "description": "Physical produce harvested from a field plot",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "cropId": { "type": "string", "maxLength": 128 },
        "fieldId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "enum": ["kg", "metric_tons", "bags_50kg", "crates_25kg", "tubers"] },
        "normalizedKg": { "type": "number" },
        "gradeQuality": { "type": "string", "enum": ["Grade A Premium", "Grade B Standard", "Industrial Processing"] },
        "storageLocation": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "organizationId", "cropId", "fieldId", "date", "quantity", "unit", "normalizedKg"]
    },
    "SaleRecord": {
      "title": "Sale Record",
      "description": "Recognized off-take sale transaction with realized cash and buyer credit",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "cropId": { "type": "string", "maxLength": 128 },
        "harvestId": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "buyerName": { "type": "string", "maxLength": 128 },
        "buyerPhone": { "type": "string", "maxLength": 64 },
        "buyerType": { "type": "string", "enum": ["Off-taker Processor", "Wholesale Aggregator", "Open Market Trader", "Retail Buyer"] },
