      },
      "required": ["id", "organizationId", "farmId", "name", "size", "unit", "irrigation", "status"]
    },
    "Crop": {
      "title": "Planted Crop",
      "description": "Crop enterprise cycle tracked through phenological stages to harvest",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "farmId": { "type": "string", "maxLength": 128 },
        "fieldId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "variety": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["Cereal / Grain", "Root & Tuber", "Horticulture / Veg", "Legume", "Cash Crop"] },
