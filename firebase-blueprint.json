      "schema": "Farm",
      "description": "Farms owned by the organization"
    },
    "/organizations/{organizationId}/fields/{fieldId}": {
      "schema": "Field",
      "description": "Field parcels under the organization"
    },
    "/organizations/{organizationId}/crops/{cropId}": {
      "schema": "Crop",
      "description": "Crop production cycles under the organization"
    },
    "/organizations/{organizationId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Operating expense disbursements under the organization"
    },
    "/organizations/{organizationId}/harvests/{harvestId}": {
