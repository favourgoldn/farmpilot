        "creditLimit": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "notes": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "name", "buyerType", "contactPerson", "phone", "state"]
    },
    "SalePayment": {
      "title": "Sale Payment Remittance",
      "description": "Customer cash or bank payment credited against a produce sales invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "saleId": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 256 },
        "date": { "type": "string", "maxLength": 32 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Bank Transfer", "Cash", "Mobile Money", "Cheque", "POS"] },
        "referenceNumber": { "type": "string", "maxLength": 128 },
        "bankName": { "type": "string", "maxLength": 128 },
        "accountCredited": { "type": "string", "maxLength": 128 },
        "receivedBy": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "saleId", "invoiceNumber", "customerName", "date", "amount", "paymentMethod"]
    },
    "ProduceAdjustment": {
      "title": "Produce Stock Adjustment",
      "description": "Post-harvest moisture reduction, sorting loss, seed retention, or shrinkage transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "cropId": { "type": "string", "maxLength": 128 },
        "harvestId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "enum": ["kg", "metric_tons", "bags_50kg", "crates_25kg", "tubers"] },
        "normalizedKg": { "type": "number" },
        "reason": { "type": "string", "enum": ["moisture_loss_shrinkage", "sorting_reject", "seed_retention", "internal_consumption", "spoilage_damage", "physical_audit_reconciliation"] },
        "notes": { "type": "string", "maxLength": 512 },
        "performedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "cropId", "date", "quantity", "unit", "reason"]
    },
    "BillingTransaction": {
      "title": "Paystack Billing Transaction",
      "description": "Commercial subscription payment receipt generated via Paystack payment gateway",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "reference": { "type": "string", "maxLength": 128 },
