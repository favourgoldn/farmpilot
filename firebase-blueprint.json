        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "state": { "type": "string", "maxLength": 64 },
        "activeStatus": { "type": "boolean" }
      },
      "required": ["id", "organizationId", "name", "role", "email"]
    },
    "CropSeason": {
      "title": "Crop Season",
