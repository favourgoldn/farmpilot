        "quantitySold": { "type": "number" },
        "unit": { "type": "string", "enum": ["kg", "metric_tons", "bags_50kg", "crates_25kg", "tubers"] },
        "normalizedKg": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "outstandingAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["paid", "outstanding", "partial"] },
        "notes": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "organizationId", "cropId", "invoiceNumber", "buyerName", "date", "quantitySold", "unit", "unitPrice", "totalAmount", "amountPaid", "outstandingAmount", "paymentStatus"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Tracked input commodity stored in farm warehouse",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "farmId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
