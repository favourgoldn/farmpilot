        "reason": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "organizationId", "farmId", "inventoryItemId", "type", "quantity", "unit", "date"]
    },
    "ReceiptRecord": {
      "title": "Receipt Voucher",
      "description": "Audit receipts and digital payment vouchers for farm expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "farmId": { "type": "string", "maxLength": 128 },
        "receiptNumber": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "vendor": { "type": "string", "maxLength": 256 },
        "date": { "type": "string", "maxLength": 32 },
        "amount": { "type": "number" },
        "auditStatus": { "type": "string", "enum": ["verified", "pending_audit", "flagged"] }
      },
      "required": ["id", "organizationId", "farmId", "receiptNumber", "vendor", "date", "amount"]
    },
    "Customer": {
      "title": "Customer / Off-taker",
      "description": "Commodity buyer, industrial off-taker, or market aggregator with contact and credit terms",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "buyerType": { "type": "string", "enum": ["Off-taker Processor", "Wholesale Aggregator", "Open Market Trader", "Retail Buyer", "Export Merchant"] },
        "contactPerson": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 256 },
        "state": { "type": "string", "maxLength": 64 },
        "marketHub": { "type": "string", "maxLength": 128 },
