      "description": "Operational duties under the organization"
    },
    "/organizations/{organizationId}/team/{teamMemberId}": {
      "schema": "TeamMember",
      "description": "Authorized staff profiles under the organization"
    },
    "/organizations/{organizationId}/seasons/{seasonId}": {
      "schema": "CropSeason",
      "description": "Agricultural crop seasons under the organization"
    },
    "/organizations/{organizationId}/suppliers/{supplierId}": {
