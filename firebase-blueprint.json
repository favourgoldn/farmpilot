        "seedSupplier": { "type": "string", "maxLength": 128 },
        "spacingNotes": { "type": "string", "maxLength": 256 },
        "activeStatus": { "type": "boolean" }
      },
      "required": ["id", "organizationId", "farmId", "fieldId", "name", "variety", "category", "stage"]
    },
    "Expense": {
      "title": "Operating Expense",
      "description": "Financial expenditure for seeds, fertilizers, chemicals, labor, or haulage",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "farmId": { "type": "string", "maxLength": 128 },
        "fieldId": { "type": "string", "maxLength": 128 },
        "cropId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "enum": ["seeds_seedlings", "fertilizer_chemicals", "mechanization_fuel", "labor", "logistics_packaging", "lease_utilities", "other"] },
        "description": { "type": "string", "maxLength": 256 },
        "amount": { "type": "number" },
        "vendor": { "type": "string", "maxLength": 128 },
