        "customerName": { "type": "string", "maxLength": 128 },
        "farmName": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 256 },
        "receiptNumber": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "organizationId", "reference", "amountNgn", "planId", "status", "paidAt"]
    }
