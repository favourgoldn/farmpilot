        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "overdue"] },
        "assignedTo": { "type": "string", "maxLength": 128 },
        "fieldId": { "type": "string", "maxLength": 128 },
        "cropId": { "type": "string", "maxLength": 128 }
