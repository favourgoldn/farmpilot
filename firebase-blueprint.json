    },
    "/organizations/{organizationId}/flocks/{flockId}": {
      "description": "Poultry flocks registered under the organization"
    },
    "/organizations/{organizationId}/flock_movements/{movementId}": {
      "description": "Flock population additions, mortalities, culls, and sales movements"
